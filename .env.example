# Port the web UI listens on. Must be set before the container starts.
WEB_PORT=8080

# Seed values — only used on first boot if /data/reader-settings.json does not
# exist. After that, all settings are managed via the Admin panel in the UI.
# Remove these from Portainer once the settings file has been created.
RTSP_URL=rtsp://CAMERA_HOST:554/STREAM_PATH
RTSP_USER=
RTSP_PASS=
HA_WEBHOOK_URL=
# Ollama server used to read the display digits, and the vision model to use.
OLLAMA_URL=http://OLLAMA_HOST:11434
OLLAMA_MODEL=lfm3-vl:latest
HA_WEBHOOK_TIMEOUT=5
