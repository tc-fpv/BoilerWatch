# Reolink RTSP stream; credentials are supplied separately.
RTSP_URL=rtsp://CAMERA_HOST:554/STREAM_PATH
RTSP_USER=
RTSP_PASS=

# Camera polling, alert delay, and low-pressure threshold.
POLL_SECONDS=30
LOW_THRESHOLD=1.0
ALERT_DELAY_MINUTES=5

# Optional Home Assistant webhook URL. Keep the webhook ID private.
HA_WEBHOOK_URL=
HA_WEBHOOK_TIMEOUT=5

# Viewer port and display geometry for a 640x480 frame.
WEB_PORT=8080
ROI_X=330
ROI_Y=238
ROI_W=110
ROI_H=94
DIGIT_BOXES=0,0,22,85;30,3,48,76
DECIMAL_BOX=13,68,9,8
EXPECTED_FORMAT=auto